{
  "name": "local-git-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:ui": "playwright test",
    "check": "tsc --noEmit",
    "start": "pnpm --filter @gitui/server start",
    "format": "prettier --write apps packages tests *.ts *.json *.yaml README.md"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
